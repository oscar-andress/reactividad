{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-tests.sh\"",
            "if": "Bash(git commit*)",
            "timeout": 180,
            "statusMessage": "Running ./mvnw test before allowing commit..."
          }
        ]
      }
    ]
  }
}
